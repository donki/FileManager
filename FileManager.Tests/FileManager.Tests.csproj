<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas de la logica de File Manager (constitucion General 8.6). La app es un proyecto MAUI
       Android de un solo proyecto: aqui se enlazan sus ficheros puros (servicios, modelos, ayudantes)
       y se compilan para net10.0, sin interfaz ni dispositivo. Lo poco de MAUI que tocan
       (Preferences) lo sustituye un doble en memoria de Stubs/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FileManager.Tests</RootNamespace>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverlet.runsettings</RunSettingsFilePath>
    <!-- La cuna de Preferences (Stubs/) tapa a la de MAUI a proposito. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- Con MAUI se compilan tambien los XAML de las paginas, el Shell y la App: las pruebas crean
         las paginas de verdad (sin plataforma debajo) y pulsan sus controles. -->
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <OutputType>Library</OutputType>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit y su runner (Apache-2.0), Microsoft.NET.Test.Sdk y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui" />
  </ItemGroup>

  <!-- Codigo de la app que se prueba (enlazado, no copiado): todo lo que no es de Platforms/. -->
  <ItemGroup>
    <Compile Include="..\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\Helpers\*.cs" Link="App\Helpers\%(Filename)%(Extension)" />
    <Compile Include="..\Services\*.cs" Link="App\Services\%(Filename)%(Extension)" />
    <Compile Include="..\ViewModels\*.cs" Link="App\ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\Pages\*.xaml.cs" Link="App\Pages\%(Filename)%(Extension)" DependentUpon="%(Filename)" />
    <MauiXaml Include="..\Pages\*.xaml" Link="App\Pages\%(Filename)%(Extension)" />
    <Compile Include="..\App.xaml.cs" Link="App\App.xaml.cs" />
    <MauiXaml Include="..\App.xaml" Link="App.xaml" />
    <Compile Include="..\AppShell.xaml.cs" Link="App\AppShell.xaml.cs" />
    <MauiXaml Include="..\AppShell.xaml" Link="App\AppShell.xaml" />
    <Compile Include="..\MauiProgram.cs" Link="App\MauiProgram.cs" />
    <MauiXaml Include="..\Resources\Styles\*.xaml" Link="Resources\Styles\%(Filename)%(Extension)" />
    <Compile Include="..\..\Shared\ModernDialog.cs" Link="Shared\ModernDialog.cs" />
    <Compile Include="..\..\Shared\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
    <Compile Include="..\..\Shared\AuthorNotes.cs" Link="Shared\AuthorNotes.cs" />
  </ItemGroup>
</Project>
