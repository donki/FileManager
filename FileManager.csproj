<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android36.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FileManager</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>File Manager</ApplicationTitle>

    <!-- App Identifier (constitucion 4: com.socratic.[nombre-aplicacion]) -->
    <ApplicationId>com.socratic.filemanager</ApplicationId>

    <!-- Versions (constitucion 6: ambos valores en sincronia) -->
    <ApplicationDisplayVersion>2026.08.02.0</ApplicationDisplayVersion>
    <ApplicationVersion>202608020</ApplicationVersion>

    <!-- Accept Android SDK Licenses -->
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>

    <!-- Package Information -->
    <PackageId>FileManager</PackageId>
    <Title>File Manager</Title>
    <Product>File Manager</Product>
    <Description>Gestor de ficheros para Android: explorar, copiar, mover, renombrar, comprimir y compartir ficheros del dispositivo.</Description>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>files;filemanager;explorer;android;maui;dotnet</PackageTags>
    <Authors>Socratic</Authors>
    <Company>Socratic</Company>

    <!-- Platform versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- Android specific -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <TargetSdkVersion>36</TargetSdkVersion>
    <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <UseInterpreter>false</UseInterpreter>

    <AssemblyVersion>2026.07.15.0</AssemblyVersion>
    <FileVersion>2026.07.15.0</FileVersion>
  </PropertyGroup>

  <!-- Release configuration for Android -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>false</AndroidKeyStore>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!--
    Ensamblados embebidos en cualquier despliegue, Debug y Release (constitucion A.7).
    Con Fast Deployment los ensamblados no viajan en el APK y la app aborta al arrancar
    con "No assemblies found".
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon: carpeta abierta sobre indigo unificado (#3525CD). El rediseño del 28-jul
         cambio los SVG pero se dejo aqui el azul de la marca anterior. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3525CD" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3525CD" BaseSize="180,180" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <!-- Ficheros compartidos por las 7 apps (una sola fuente de verdad). Se perdieron en el
       incidente de reorganizacion: sin ellos el proyecto no compila, porque las paginas usan
       SocShared.ModernDialog. -->
  <ItemGroup>
    <Compile Include="..\Shared\AuthorNotes.cs" Link="AuthorNotes.cs" />
    <Compile Include="..\Shared\ModernDialog.cs" Link="ModernDialog.cs" />
  </ItemGroup>

  <!-- Firma Release centralizada (constitucion 7). Define AndroidKeyStore=true, por lo que
       manda sobre el valor de la seccion de Release de mas arriba. -->
  <Import Project="..\Shared\signing.props" />

</Project>
