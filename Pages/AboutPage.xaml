<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileManager.Pages.AboutPage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Cabecera -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="30,25" Spacing="10">
                    <Image Source="about_logo.png"
                           HeightRequest="84"
                           WidthRequest="84"
                           HorizontalOptions="Center" />

                    <Label x:Name="AppNameLabel"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />

                    <Label x:Name="VersionLabel"
                           Style="{StaticResource HintText}"
                           FontSize="15"
                           HorizontalOptions="Center" />

                    <Label x:Name="DescriptionLabel"
                           Style="{StaticResource HintText}"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="CompanyLabel"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Contacto -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_mail.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center" x:Name="ContactTitle" Style="{StaticResource CardTitle}" />
                    </Grid>

                    <Button x:Name="ContactButton"
                            Style="{StaticResource OutlineButton}"
                            Clicked="OnContactEmailClicked"
                            HorizontalOptions="Fill" />

                    <Label x:Name="ContactHint"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_language.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center" x:Name="LanguageTitle" Style="{StaticResource CardTitle}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="SpanishButton"
                                ImageSource="ic_flag_es.png"
                                ContentLayout="Left,8"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Padding="10,10"
                                Clicked="OnSpanishClicked" />

                        <Button Grid.Column="1"
                                x:Name="EnglishButton"
                                ImageSource="ic_flag_us.png"
                                ContentLayout="Left,8"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Padding="10,10"
                                Clicked="OnEnglishClicked" />
                    </Grid>

                    <Label x:Name="LanguageHint"
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Privacidad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_lock.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                           x:Name="PrivacyTitle"
                           Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Success}" />
                    </Grid>
                    <Label x:Name="PrivacyText"
                           Style="{StaticResource BodyText}"
                           FontSize="13"
                           LineHeight="1.4" />
                </VerticalStackLayout>
            </Border>

            <!-- Licencia -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_license.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center" x:Name="LicenseTitle" Style="{StaticResource CardTitle}" />
                    </Grid>
                    <Label x:Name="LicenseText"
                           Style="{StaticResource BodyText}"
                           FontSize="13"
                           LineHeight="1.4" />
                    <Label Text="MIT License · Copyright © 2026 Socratic"
                           Style="{StaticResource HintText}"
                           FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- Aviso legal -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_legal_danger.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                           x:Name="LegalTitle"
                           Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Danger}" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeThickness="0"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="LegalText1"
                                   Style="{StaticResource BodyText}"
                                   FontSize="13"
                                   LineHeight="1.4" />
                            <Label x:Name="LegalText2"
                                   Style="{StaticResource BodyText}"
                                   FontSize="13"
                                   LineHeight="1.4" />

                            <Border BackgroundColor="{StaticResource Danger}"
                                    StrokeThickness="0"
                                    Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center">
                                    <Image Source="ic_warning_w.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Label x:Name="WarningText"
                                           Grid.Column="1"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           LineHeight="1.4"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="BackButton"
                    ImageSource="ic_arrow_back.png"
                    ContentLayout="Left,8"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Fill"
                    Margin="0,4,0,16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
