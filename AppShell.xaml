<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="FileManager.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:FileManager.Pages"
       xmlns:mauiControls="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
       Shell.FlyoutBehavior="Flyout"
       FlyoutWidth="280"
       Shell.BackgroundColor="{StaticResource Primary}"
       Shell.ForegroundColor="{StaticResource White}"
       Shell.TitleColor="{StaticResource White}"
       FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <!-- Los items del menu toman texto y fondo de los tokens de tema (constitucion A.9): sin
         esto el texto saldria con el color por defecto y podria quedar invisible en modo oscuro. -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="mauiControls:BaseShellItem">
            <Grid HeightRequest="52" Padding="20,0" ColumnDefinitions="24,*" ColumnSpacing="16">
                <Image Grid.Column="0"
                       Source="{Binding FlyoutIcon}"
                       HeightRequest="22"
                       WidthRequest="22"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" HeightRequest="140" Padding="20,40,20,20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                <Image Source="menu_logo.png" HeightRequest="48" WidthRequest="48" HorizontalOptions="Start" />
                <Label x:Name="HeaderTitle"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem x:Name="HomeItem" Route="MainPage" FlyoutIcon="ic_home.png">
        <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem x:Name="SettingsItem" Route="SettingsPage" FlyoutIcon="ic_settings.png">
        <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

    <FlyoutItem x:Name="AboutItem" Route="AboutPage" FlyoutIcon="ic_info.png">
        <ShellContent ContentTemplate="{DataTemplate pages:AboutPage}" Route="AboutPage" />
    </FlyoutItem>

    <!-- Pie del menú con la versión (constitución §6: versión visible). -->
    <Shell.FlyoutFooter>
        <Grid Padding="20,12" ColumnDefinitions="*">
            <Label x:Name="FooterVersionLabel"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
